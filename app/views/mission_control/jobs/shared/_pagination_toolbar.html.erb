<nav class="buttons is-right" role="navigation" aria-label="Pagination">
  <span class="mr-3"><%= page.index %> / <%= page.pages_count || "..." %></span>

  <% if page.first? %>
    <span class="pagination-previous is-disabled" role="link" aria-disabled="true">↞</span>
    <span class="pagination-previous is-disabled" role="link" aria-disabled="true">Previous page</span>
  <% else %>
    <%= link_to "↞", url_for(page: 1, **filter_param), class: "pagination-previous" %>
    <%= link_to "Previous page", url_for(page: page.previous_index, **filter_param), class: "pagination-previous" %>
  <% end %>

  <% if page.last? %>
    <span class="pagination-next is-disabled" role="link" aria-disabled="true">Next page</span>
    <span class="pagination-next is-disabled" role="link" aria-disabled="true">↠</span>
  <% else %>
    <%= link_to "Next page", url_for(page: page.next_index, **filter_param), class: "pagination-next" %>
    <%= link_to "↠", url_for(page: page.pages_count, **filter_param), class: "pagination-next" %>
  <% end %>
</nav>
