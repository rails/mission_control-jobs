<% if application.servers.many? %>
  <div class="server-selector navbar-item">
    <div class="tabs is-toggle is-toggle-rounded is-small">
      <ul>
        <% application.servers.each do |server| %>
          <% selected = selected_server?(server) %>
          <%= tag.li class: [ "is-active": selected ] do %>
            <%= link_to application_queues_path(application, server_id: server), aria: { current: ("page" if selected) } do %>
              <span><%= server.name %></span>
            <% end %>
          <% end %>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
